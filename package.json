{
  "name": "vs-docs",
  "displayName": "VS Docs",
  "description": "Read-only viewer for Word (.docx, .doc), Excel (.xlsx, .xls, .csv, .ods), PDF (.pdf), ODT (.odt), RTF (.rtf) with adaptive Dark Mode in VS Code",
  "version": "1.0.0",
  "publisher": "vcdocs",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vcdocs/vs-docs"
  },
  "keywords": [
    "vs-docs",
    "office",
    "word",
    "excel",
    "docx",
    "xlsx",
    "pdf",
    "viewer",
    "dark-mode",
    "csv"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:vcdocs.docViewer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vcdocs.docViewer",
        "displayName": "VS Docs",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.doc"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.ods"
          },
          {
            "filenamePattern": "*.odt"
          },
          {
            "filenamePattern": "*.pdf"
          },
          {
            "filenamePattern": "*.rtf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vcdocs.openViewer",
        "title": "Open with VS Docs"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "vcdocs.openViewer",
          "when": "resourceExt == .docx || resourceExt == .doc || resourceExt == .xlsx || resourceExt == .xls || resourceExt == .xlsm || resourceExt == .csv || resourceExt == .tsv || resourceExt == .ods || resourceExt == .odt || resourceExt == .pdf || resourceExt == .rtf",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/testParsers.js",
    "package": "node --experimental-require-module ./node_modules/@vscode/vsce/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "docx-preview": "^0.3.1",
    "dompurify": "^3.2.1",
    "esbuild": "^0.24.0",
    "pdfjs-dist": "^3.11.174",
    "typescript": "^5.6.3",
    "xlsx": "^0.18.5"
  }
}
